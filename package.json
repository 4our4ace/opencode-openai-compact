{
  "name": "@4our4ace/opencode-openai-compact",
  "version": "1.3.1",
  "description": "OpenCode plugin that stores OpenAI Responses API compaction checkpoints in SQLite.",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "configSchema.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.v2.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.v2.json",
    "test": "vitest run"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "openai",
    "compact"
  ],
  "author": "4our4ace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4our4ace/opencode-openai-compact.git"
  },
  "bugs": {
    "url": "https://github.com/4our4ace/opencode-openai-compact/issues"
  },
  "homepage": "https://github.com/4our4ace/opencode-openai-compact#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12.0",
    "opencode": ">=1.18.4"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-next-16909",
    "@opentui/solid": "0.4.5",
    "jsonc-parser": "3.3.1",
    "solid-js": "1.9.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
